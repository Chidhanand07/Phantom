# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Database (host port 5433 to avoid conflict with other local services)
DATABASE_URL=postgresql://phantom:phantom@localhost:5433/phantom

# Redis (host port 6380 to avoid conflict)
REDIS_URL=redis://localhost:6380

# News
NEWS_API_KEY=your_newsapi_key_here

# Portfolio limits
INITIAL_PORTFOLIO_VALUE=100000
MAX_POSITION_PCT=0.20
MAX_SECTOR_PCT=0.40
MIN_CASH_PCT=0.10
MAX_POSITIONS=5

# Agent
AGENT_CYCLE_MINUTES=15
MIN_CONFIDENCE_TO_TRADE=0.65

# Frontend
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/feed
NEXT_PUBLIC_API_URL=http://localhost:8001
